#include <stdio.h>

int main() {
    int n;
    
    printf("Enter the size of array: ");
    scanf("%d", &n);
    
    int arr[n];
    int visited[n];
    
    for(int i = 0; i < n; i++) {
        visited[i] = 0;
    }
    
    printf("Enter %d elements: ", n);
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    printf("\nArray elements: ");
    for(int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    
    printf("Duplicate elements: ");
    int dupCount = 0;
    
    for(int i = 0; i < n; i++) {
        if(visited[i] == 1) {
            continue;
        }
        
        int count = 1;
        for(int j = i + 1; j < n; j++) {
            if(arr[i] == arr[j]) {
                count++;
                visited[j] = 1;
            }
        }
        
        if(count > 1) {
            printf("%d ", arr[i]);
            dupCount++;
        }
    }
    
    if(dupCount == 0) {
        printf("No duplicates found");
    }
    printf("\n");
    printf("Total duplicate values: %d\n", dupCount);
    
    return 0;
}
