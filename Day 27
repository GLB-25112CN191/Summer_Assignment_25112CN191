    char newName[50];
    fgets(newName, sizeof(newName), stdin);
    if(newName[0] != '\n') {
        newName[strcspn(newName, "\n")] = '\0';
        strcpy(students[found].name, newName);
    }
    
    printf("Current Age: %d\n", students[found].age);
    printf("New Age (0 to keep): ");
