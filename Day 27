void updateEmployee(Employee employees[], int count) {
    if(count == 0) {
        printf("No employees in database!\n");
        return;
    }
    
    int id;
    printf("Enter Employee ID to update: ");
    scanf("%d", &id);
    getchar();
    
    int found = -1;
    for(int i = 0; i < count; i++) {
        if(employees[i].empId == id) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ Employee not found!\n");
        return;
    }
    
    printf("\n--- Update Employee (ID: %d) ---\n", employees[found].empId);
    printf("Current Name: %s\n", employees[found].name);
    printf("New Name (press Enter to keep): ");
    char newName[50];
    fgets(newName, sizeof(newName), stdin);
    if(newName[0] != '\n') {
        newName[strcspn(newName, "\n")] = '\0';
        strcpy(employees[found].name, newName);
    }
    
    printf("Current Basic Salary: ₹%.2f\n", employees[found].basicSalary);
    printf("New Basic Salary (-1 to keep): ");
    float salary;
    scanf("%f", &salary);
    if(salary >= 0) {
        employees[found].basicSalary = salary;
        // Recalculate salary
        calculateSalary(&employees[found]);
    }
    
    printf("✅ Employee details updated!\n");
}
