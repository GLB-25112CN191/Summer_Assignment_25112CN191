// Calculate salary components
void calculateSalary(Employee *e) {
    // DA = 50% of basic
    e->da = e->basicSalary * 0.50;
    
    // HRA = 20% of basic
    e->hra = e->basicSalary * 0.20;
    
    // PF = 12% of basic
    e->pf = e->basicSalary * 0.12;
    
    // Tax calculation (simplified)
    float annual = e->basicSalary * 12;
    if(annual <= 250000) {
        e->tax = 0;
    } else if(annual <= 500000) {
        e->tax = (annual - 250000) * 0.05 / 12;
    } else if(annual <= 1000000) {
        e->tax = (12500 + (annual - 500000) * 0.20) / 12;
    } else {
        e->tax = (112500 + (annual - 1000000) * 0.30) / 12;
    }
    
    // Gross Salary = Basic + DA + HRA
    e->grossSalary = e->basicSalary + e->da + e->hra;
    
    // Net Salary = Gross - PF - Tax
    e->netSalary = e->grossSalary - e->pf - e->tax;
}

