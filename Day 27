           employees[highEarner].salary, employees[highEarner].name);
    printf("Lowest Salary: ₹%.2f (Employee: %s)\n", 
           employees[0].salary, employees[0].name);
}

// Department report
void departmentReport(Employee employees[], int count) {
    if(count == 0) {
        printf("No employees in database!\n");
        return;
    }
    
    char depts[20][30];
    int deptCount = 0;
    int deptTotal[20] = {0};
    float deptSalary[20] = {0};
    
    // Find unique departments
    for(int i = 0; i < count; i++) {
        int found = -1;
        for(int j = 0; j < deptCount; j++) {
            if(strcmp(employees[i].department, depts[j]) == 0) {
                found = j;
                break;
            }
        }
        if(found == -1) {
            strcpy(depts[deptCount], employees[i].department);
            deptTotal[deptCount] = 1;
            deptSalary[deptCount] = employees[i].salary;
            deptCount++;
        } else {
            deptTotal[found]++;
            deptSalary[found] += employees[i].salary;
        }
    }
    
    printf("\n--- Department Report ---\n");
    printf("=================================================================\n");
    printf("%-20s %-10s %-15s %-15s\n", 
           "Department", "Employees", "Total Salary", "Avg Salary");
    printf("=================================================================\n");
    
    for(int i = 0; i < deptCount; i++) {
        printf("%-20s %-10d ₹%-14.2f ₹%-14.2f\n", 
               depts[i], deptTotal[i], deptSalary[i], deptSalary[i] / deptTotal[i]);
    }
    printf("=================================================================\n");
}






