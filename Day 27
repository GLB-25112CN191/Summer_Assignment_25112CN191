    fgets(e.designation, sizeof(e.designation), stdin);
    e.designation[strcspn(e.designation, "\n")] = '\0';
    
    printf("Basic Salary: ₹");
    scanf("%f", &e.basicSalary);
    
    // Initialize other fields
    e.da = 0;
    e.hra = 0;
    e.pf = 0;
    e.tax = 0;
    e.grossSalary = 0;
    e.netSalary = 0;
    
    employees[*count] = e;
    (*count)++;
    printf("✅ Employee added successfully!\n");
}


