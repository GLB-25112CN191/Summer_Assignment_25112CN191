    scanf("%f", &percent);
    if(percent >= 0) {
        students[found].percentage = percent;
    }
    
    printf("✅ Student details updated!\n");
}


void deleteStudent(Student students[], int *count) {
    if(*count == 0) {
        printf("No students in database!\n");
        return;
    }
    
    int rollNo;
    printf("Enter Roll Number to delete: ");
    scanf("%d", &rollNo);
    
    int found = -1;
    for(int i = 0; i < *count; i++) {
        if(students[i].rollNo == rollNo) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ Student not found!\n");
        return;
    }
    
    printf("Are you sure you want to delete %s? (y/n): ", students[found].name);
    char confirm;
    scanf(" %c", &confirm);
    
    if(confirm == 'y' || confirm == 'Y') {
        for(int i = found; i < *count - 1; i++) {
            students[i] = students[i + 1];
        }
        (*count)--;
        printf("✅ Student deleted successfully!\n");
    } else {
        printf("Deletion cancelled.\n");
    }
}


void calculateStatistics(Student students[], int count) {
    if(count == 0) {
        printf("No students in database!\n");
        return;
    }
    
    float total = 0;
    int topperIdx = 0;
    int failCount = 0;
    
    for(int i = 0; i < count; i++) {
        total += students[i].percentage;
        if(students[i].percentage > students[topperIdx].percentage) {
            topperIdx = i;
        }
        if(students[i].percentage < 40) {
            failCount++;
        }
    }
    
    float average = total / count;
    
    printf("\n--- Statistics ---\n");
    printf("Total Students: %d\n", count);
    printf("Average Percentage: %.2f%%\n", average);
    printf("Highest Percentage: %.2f%% (Topper: %s)\n", 
           students[topperIdx].percentage, students[topperIdx].name);
    printf("Number of Students with < 40%%: %d\n", failCount);
    printf("Pass Percentage: %.2f%%\n", (float)(count - failCount) / count * 100);
}

void sortStudents(Student students[], int count) {
    if(count <= 1) {
        printf("Not enough students to sort!\n");
        return;
    }
    
    int choice;
    printf("\n--- Sort Students ---\n");
    printf("1. Sort by Name (Alphabetical)\n");
    printf("2. Sort by Percentage (Descending)\n");
    printf("Enter choice: ");
    scanf("%d", &choice);
    
    Student temp;
    for(int i = 0; i < count - 1; i++) {
        for(int j = 0; j < count - i - 1; j++) {
            int swap = 0;
            if(choice == 1) {
                if(strcmp(students[j].name, students[j + 1].name) > 0) {
                    swap = 1;
                }
            } else if(choice == 2) {
                if(students[j].percentage < students[j + 1].percentage) {
                    swap = 1;
                }
            }
            if(swap) {
                temp = students[j];
                students[j] = students[j + 1];
                students[j + 1] = temp;
            }
        }
    }
    
    printf("✅ Students sorted successfully!\n");
    displayStudents(students, count);
}






