#include <stdio.h>
#include <stdbool.h>

bool isPerfect(int num) {
    if(num <= 1) return false;
       int sum = 0;
    for(int i = 1; i <= num/2; i++) {
        if(num % i == 0) {
            sum += i;
        }
    }
    
    return (sum == num);
}

int main() {
    int num;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    if(isPerfect(num)) {
        printf("%d is a perfect number\n", num);
        
        printf("Factors: ");
        for(int i = 1; i <= num/2; i++) {
            if(num % i == 0) {
                printf("%d ", i);
            }
        }
        printf("\n");
    }
    else {
        printf("%d is not a perfect number\n", num);
    }
    
    return 0;
}




#include <stdio.h>
#include <stdbool.h>

int factorial(int n) {
    int fact = 1;
    for(int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

bool isStrong(int num) {
    int originalNum = num;
    int sum = 0;
    
    while(num > 0) {
        int digit = num % 10;
        sum += factorial(digit);
        num /= 10;
    }
    
    return (sum == originalNum);
}

int main() {
    int num;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    if(isStrong(num)) {
        printf("%d is a strong number\n", num);
        
        int temp = num;
        printf("%d = ", num);
        while(temp > 0) {
            int digit = temp % 10;
            printf("%d! ", digit);
            if(temp / 10 > 0) printf("+ ");
            temp /= 10;
        }
        printf("\n");
    }
    else {
        printf("%d is not a strong number\n", num);
    }
    
    return 0;
}




#include <stdio.h>

int main() {
    int num;
    int count = 0;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    if(num == 0) {
        printf("Every non-zero number is a factor of 0\n");
        return 0;
    }
     printf("Factors of %d are:\n", num);
    
    int absNum = (num < 0) ? -num : num;
    
    for(int i = 1; i <= absNum; i++) {
        if(absNum % i == 0) {
            if(num < 0) {
                printf("%d and %d ", -i, i);
                count += 2;
            }
            else {
                printf("%d ", i);
                count++;
            }
        }
    }
    
    printf("\nTotal factors: %d\n", count);
    
    return 0;
}




#include <stdio.h>
#include <stdbool.h>
#include <math.h>

bool isPrime(int n) {
    if(n <= 1) return false;
    if(n == 2) return true;
    if(n % 2 == 0) return false;
    
    for(int i = 3; i <= sqrt(n); i += 2) {
        if(n % i == 0) return false;
    }
    return true;
}

int largestPrimeFactor1(int n) {
    int largest = 1;
    
    for(int i = 2; i <= n; i++) {
        if(n % i == 0 && isPrime(i)) {
            largest = i;
        }
    }
    return largest;
}

int largestPrimeFactor2(int n) {
    int largest = -1;
    
    while(n % 2 == 0) {
        largest = 2;
        n /= 2;
    }
     for(int i = 3; i <= sqrt(n); i += 2) {
        while(n % i == 0) {
            largest = i;
            n /= i;
        }
    }
     if(n > 2) {
        largest = n;
    }
    
    return largest;
}

int main() {
    int num;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    if(num <= 1) {
        printf("%d has no prime factors\n", num);
        return 0;
    }
    
    int result = largestPrimeFactor2(num);
    
    printf("Largest prime factor of %d is: %d\n", num, result);
    printf("Prime factors: ");
    int temp = num;
    for(int i = 2; i <= temp; i++) {
        while(temp % i == 0) {
            if(isPrime(i)) {
                printf("%d ", i);
                temp /= i;
            }
        }
    }
    printf("\n");
    
    return 0;
}
