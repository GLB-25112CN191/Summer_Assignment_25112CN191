#include <stdio.h>

int main() {
    int r1, c1, r2, c2;
    
    printf("Enter rows and columns of first matrix: ");
    scanf("%d %d", &r1, &c1);
    printf("Enter rows and columns of second matrix: ");
    scanf("%d %d", &r2, &c2);
    
    // Check if multiplication is possible
    if(c1 != r2) {
        printf("\nMatrix multiplication not possible!\n");
        printf("Columns of first matrix (%d) must equal rows of second matrix (%d)\n", c1, r2);
        return 1;
    }
    
    int A[r1][c1], B[r2][c2], C[r1][c2];
    
    // Input first matrix
    printf("\nEnter elements of first matrix (%dx%d):\n", r1, c1);
    for(int i = 0; i < r1; i++) {
        for(int j = 0; j < c1; j++) {
            printf("A[%d][%d] = ", i, j);
            scanf("%d", &A[i][j]);
        }
    }
    
    // Input second matrix
    printf("\nEnter elements of second matrix (%dx%d):\n", r2, c2);
    for(int i = 0; i < r2; i++) {
        for(int j = 0; j < c2; j++) {
            printf("B[%d][%d] = ", i, j);
            scanf("%d", &B[i][j]);
        }
    }
    
    // Multiply matrices
    for(int i = 0; i < r1; i++) {
        for(int j = 0; j < c2; j++) {
            C[i][j] = 0;
            for(int k = 0; k < c1; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
    
    // Display first matrix
    printf("\nFirst Matrix (%dx%d):\n", r1, c1);
    for(int i = 0; i < r1; i++) {
        for(int j = 0; j < c1; j++) {
            printf("%4d ", A[i][j]);
        }
        printf("\n");
    }
    
    // Display second matrix
    printf("\nSecond Matrix (%dx%d):\n", r2, c2);
    for(int i = 0; i < r2; i++) {
        for(int j = 0; j < c2; j++) {
            printf("%4d ", B[i][j]);
        }
        printf("\n");
    }
    
    // Display product matrix
    printf("\nProduct Matrix (%dx%d):\n", r1, c2);
    for(int i = 0; i < r1; i++) {
        for(int j = 0; j < c2; j++) {
            printf("%4d ", C[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}






#include <stdio.h>

int main() {
    int n;
    
    printf("Enter the size of square matrix: ");
    scanf("%d", &n);
    
    int matrix[n][n];
    
    // Input matrix
    printf("\nEnter elements of matrix:\n");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            printf("matrix[%d][%d] = ", i, j);
            scanf("%d", &matrix[i][j]);
        }
    }
    
    // Display matrix
    printf("\nMatrix:\n");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            printf("%4d ", matrix[i][j]);
        }
        printf("\n");
    }
    
    // Check if symmetric
    int isSymmetric = 1;
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            if(matrix[i][j] != matrix[j][i]) {
                isSymmetric = 0;
                break;
            }
        }
        if(!isSymmetric) break;
    }
    
    if(isSymmetric) {
        printf("\nThe matrix is SYMMETRIC\n");
        printf("(Matrix is equal to its transpose)\n");
    } else {
        printf("\nThe matrix is NOT SYMMETRIC\n");
        
        // Show where it fails
        printf("\nDifferences found:\n");
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n; j++) {
                if(matrix[i][j] != matrix[j][i]) {
                    printf("matrix[%d][%d] = %d, matrix[%d][%d] = %d\n", 
                           i, j, matrix[i][j], j, i, matrix[j][i]);
                }
            }
        }
    }
    
    return 0;
}







#include <stdio.h>

int main() {
    int rows, cols;
    
    printf("Enter the number of rows: ");
    scanf("%d", &rows);
    printf("Enter the number of columns: ");
    scanf("%d", &cols);
    
    int matrix[rows][cols];
    
    // Input matrix
    printf("\nEnter elements of matrix:\n");
    for(int i = 0; i < rows; i++) {
        for(int j = 0; j < cols; j++) {
            printf("matrix[%d][%d] = ", i, j);
            scanf("%d", &matrix[i][j]);
        }
    }
    
    // Display matrix
    printf("\nMatrix:\n");
    for(int i = 0; i < rows; i++) {
        for(int j = 0; j < cols; j++) {
            printf("%4d ", matrix[i][j]);
        }
        printf("\n");
    }
    
    // Calculate and display row-wise sum
    printf("\nRow-wise Sum:\n");
    int totalSum = 0;
    for(int i = 0; i < rows; i++) {
        int rowSum = 0;
        for(int j = 0; j < cols; j++) {
            rowSum += matrix[i][j];
        }
        printf("Row %d: %d\n", i + 1, rowSum);
        totalSum += rowSum;
    }
    printf("\nTotal Sum of all elements: %d\n", totalSum);
    
    return 0;
}







