#include <stdio.h>

long long factorial(int n) {
    if(n == 0 || n == 1) {
        return 1;
    }
    else {
        return n * factorial(n - 1);
    }
}

int main() {
    int n;
    
    printf("Enter a number: ");
    scanf("%d", &n);
    
    if(n < 0) {
        printf("Factorial is not defined for negative numbers\n");
    }
    else {
        printf("Factorial of %d = %lld\n", n, factorial(n));
    }
    
    return 0;
}





#include <stdio.h>

int fibonacci(int n) {
    if(n == 1) {
        return 0;
    }
    if(n == 2) {
        return 1;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

int main() {
    int n;
    
    printf("Enter the position (n): ");
    scanf("%d", &n);
    
    if(n <= 0) {
        printf("Please enter a positive integer\n");
    }
    else {
        int result = fibonacci(n);
        if(n % 10 == 1 && n % 100 != 11)
            printf("%dst Fibonacci term = %d\n", n, result);
        else if(n % 10 == 2 && n % 100 != 12)
            printf("%dnd Fibonacci term = %d\n", n, result);
        else if(n % 10 == 3 && n % 100 != 13)
            printf("%drd Fibonacci term = %d\n", n, result);
        else
            printf("%dth Fibonacci term = %d\n", n, result);
    }
    
    return 0;
}




#include <stdio.h>
int sumOfDigits(int n) {
    if(n < 0) {
        n = -n;
    }
    
    if(n == 0) {
        return 0;
    }
    return (n % 10) + sumOfDigits(n / 10);
}

int main() {
    int num;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    int sum = sumOfDigits(num);
    
    printf("Sum of digits of %d = %d\n", num, sum);
    
    return 0;
}




#include <stdio.h>
#include <math.h>

int countDigits(int n) {
    if(n == 0) return 0;
    return 1 + countDigits(n / 10);
}

int reverseNumber(int n) {
    if(n < 0) {
        return -reverseNumber(-n);
    }
    
    if(n == 0) {
        return 0;
    }
    
    int digits = countDigits(n);
    
    int lastDigit = n % 10;
    int remaining = n / 10;
    
    return lastDigit * pow(10, digits - 1) + reverseNumber(remaining);
}

int main() {
    int num;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    int reversed = reverseNumber(num);
    
    printf("Reverse of %d = %d\n", num, reversed);
    
    return 0;
}
