#include <stdio.h>

int sum(int a, int b) {
    return a + b;
}

int main() {
    int num1, num2;
    
    printf("Enter first number: ");
    scanf("%d", &num1);
    printf("Enter second number: ");
    scanf("%d", &num2);
    
    int result = sum(num1, num2);
    
    printf("Sum of %d and %d = %d\n", num1, num2, result);
    
    return 0;
}




#include <stdio.h>

int max(int a, int b) {
