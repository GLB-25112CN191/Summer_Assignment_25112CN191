// Add contact
void addContact(Contact contacts[], int *count) {
    if(*count >= 100) {
        printf("Contact list full!\n");
        return;
    }
    
    Contact c;
    printf("\n--- Add Contact ---\n");
    c.id = *count + 1;
    
    printf("Name: ");
    fgets(c.name, sizeof(c.name), stdin);
    c.name[strcspn(c.name, "\n")] = '\0';
    
    printf("Phone Number: ");
    fgets(c.phone, sizeof(c.phone), stdin);
    c.phone[strcspn(c.phone, "\n")] = '\0';
    
    // Check for duplicate phone
    for(int i = 0; i < *count; i++) {
        if(strcmp(contacts[i].phone, c.phone) == 0) {
            printf("Phone number already exists!\n");
            return;
        }
    }
    
    printf("Email: ");
    fgets(c.email, sizeof(c.email), stdin);
    c.email[strcspn(c.email, "\n")] = '\0';
    
    printf("Address: ");
    fgets(c.address, sizeof(c.address), stdin);
    c.address[strcspn(c.address, "\n")] = '\0';
    
    printf("Group (Family/Friends/Work/Other): ");
    fgets(c.group, sizeof(c.group), stdin);
    c.group[strcspn(c.group, "\n")] = '\0';
    
    contacts[*count] = c;
    (*count)++;
    printf("✅ Contact added successfully!\n");
}

// Display all contacts
void displayContacts(Contact contacts[], int count) {
    if(count == 0) {
        printf("No contacts found!\n");
        return;
    }
    
    printf("\n--- Contact List ---\n");
