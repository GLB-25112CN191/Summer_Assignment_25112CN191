// Update contact
void updateContact(Contact contacts[], int count) {
    if(count == 0) {
        printf("No contacts found!\n");
        return;
    }
    
    int id;
    printf("Enter Contact ID to update: ");
    scanf("%d", &id);
    getchar();
    
    if(id < 1 || id > count) {
        printf("Invalid ID!\n");
        return;
    }
    
    int idx = id - 1;
    printf("\n--- Update Contact (ID: %d) ---\n", contacts[idx].id);
    printf("Current Name: %s\n", contacts[idx].name);
    printf("New Name (press Enter to keep): ");
    char newName[50];
    fgets(newName, sizeof(newName), stdin);
    if(newName[0] != '\n') {
        newName[strcspn(newName, "\n")] = '\0';
        strcpy(contacts[idx].name, newName);
    }
    
    printf("Current Phone: %s\n", contacts[idx].phone);
    printf("New Phone (press Enter to keep): ");
    char newPhone[15];
    fgets(newPhone, sizeof(newPhone), stdin);
    if(newPhone[0] != '\n') {
        newPhone[strcspn(newPhone, "\n")] = '\0';
        strcpy(contacts[idx].phone, newPhone);
    }
    
    printf("Current Email: %s\n", contacts[idx].email);
    printf("New Email (press Enter to keep): ");
    char newEmail[50];
    fgets(newEmail, sizeof(newEmail), stdin);
    if(newEmail[0] != '\n') {
        newEmail[strcspn(newEmail, "\n")] = '\0';
        strcpy(contacts[idx].email, newEmail);
    }
    
    printf("Current Group: %s\n", contacts[idx].group);
    printf("New Group (press Enter to keep): ");
    char newGroup[20];
    fgets(newGroup, sizeof(newGroup), stdin);
    if(newGroup[0] != '\n') {
        newGroup[strcspn(newGroup, "\n")] = '\0';
        strcpy(contacts[idx].group, newGroup);
    }
    
    printf("✅ Contact updated successfully!\n");
}

// Delete contact
void deleteContact(Contact contacts[], int *count) {
    if(*count == 0) {
        printf("No contacts found!\n");
        return;
    }
    
    int id;
    printf("Enter Contact ID to delete: ");
    scanf("%d", &id);
    
    if(id < 1 || id > *count) {
        printf("Invalid ID!\n");
        return;
    }
    
    printf("Are you sure you want to delete '%s'? (y/n): ", contacts[id - 1].name);
    char confirm;
    scanf(" %c", &confirm);
    
    if(confirm == 'y' || confirm == 'Y') {
        for(int i = id - 1; i < *count - 1; i++) {
            contacts[i] = contacts[i + 1];
            contacts[i].id = i + 1;
        }
        (*count)--;
        printf("✅ Contact deleted successfully!\n");
    } else {
        printf("Deletion cancelled.\n");
    }
}

// Search by group
void searchByGroup(Contact contacts[], int count) {
    if(count == 0) {
        printf("No contacts found!\n");
        return;
    }
    
    char group[20];
    printf("Enter group name to search: ");
    fgets(group, sizeof(group), stdin);
    group[strcspn(group, "\n")] = '\0';
    
    int found = 0;
    printf("\n--- Contacts in Group '%s' ---\n", group);
    printf("================================================================================\n");
    printf("%-3s %-20s %-15s %-25s\n", 
           "ID", "Name", "Phone", "Email");
    printf("================================================================================\n");
    
    for(int i = 0; i < count; i++) {
        if(strcmp(contacts[i].group, group) == 0) {
            printf("%-3d %-20s %-15s %-25s\n", 
                   contacts[i].id,
                   contacts[i].name,
                   contacts[i].phone,
                   contacts[i].email);
            found = 1;
        }
    }
    
    if(!found) {
        printf("No contacts found in group: %s\n", group);
    }
    printf("================================================================================\n");
}

// Sort contacts
void sortContacts(Contact contacts[], int count) {
    if(count <= 1) {
        printf("Not enough contacts to sort!\n");
        return;
    }
    
    Contact temp;
    for(int i = 0; i < count - 1; i++) {
        for(int j = 0; j < count - i - 1; j++) {
            if(strcmp(contacts[j].name, contacts[j + 1].name) > 0) {
                temp = contacts[j];
                contacts[j] = contacts[j + 1];
                contacts[j + 1] = temp;
            }
        }
    }
    
    // Update IDs
    for(int i = 0; i < count; i++) {
        contacts[i].id = i + 1;
    }
    
    printf("✅ Contacts sorted alphabetically!\n");
    displayContacts(contacts, count);
}

// Search by phone
void searchByPhone(Contact contacts[], int count) {
    if(count == 0) {
        printf("No contacts found!\n");
        return;
    }
    
    char phone[15];
    printf("Enter phone number to search: ");
    fgets(phone, sizeof(phone), stdin);
    phone[strcspn(phone, "\n")] = '\0';
    
    int found = 0;
    for(int i = 0; i < count; i++) {
        if(strstr(contacts[i].phone, phone) != NULL) {
            printf("\n✅ Contact Found!\n");
            printf("ID: %d\n", contacts[i].id);
            printf("Name: %s\n", contacts[i].name);
            printf("Phone: %s\n", contacts[i].phone);
            printf("Email: %s\n", contacts[i].email);
            printf("Group: %s\n", contacts[i].group);
            printf("Address: %s\n", contacts[i].address);
            found = 1;
        }
    }
    
    if(!found) {
        printf("No contact found with phone: %s\n", phone);
    }
}
