#include <stdio.h>
#include <string.h>
#include <stdlib.h>

typedef struct {
    int seatNumber;
    char passengerName[50];
    int age;
    char gender;
    char bookingStatus[20]; // "Booked", "Available", "Cancelled"
} Seat;

typedef struct {
    int bookingId;
    int seatNumber;
    char passengerName[50];
    char bookingDate[15];
    float fare;
} Booking;

// Function declarations
void initializeSeats(Seat seats[], int totalSeats);
void displaySeats(Seat seats[], int totalSeats);
void bookTicket(Seat seats[], int totalSeats, Booking bookings[], int *bookCount);
void cancelBooking(Seat seats[], int totalSeats, Booking bookings[], int *bookCount);
void viewBookings(Booking bookings[], int bookCount);
void availableSeats(Seat seats[], int totalSeats);
void viewBookingDetails(Booking bookings[], int bookCount);

int main() {
    Seat seats[50];
    Booking bookings[100];
    int totalSeats = 50;
    int bookCount = 0;
    int choice;
    
    initializeSeats(seats, totalSeats);
    
    do {
        printf("\n=========================================\n");
        printf("         TICKET BOOKING SYSTEM           \n");
        printf("=========================================\n");
        printf("1. Display Seats\n");
        printf("2. Book Ticket\n");
        printf("3. Cancel Booking\n");
        printf("4. View All Bookings\n");
        printf("5. View Available Seats\n");
        printf("6. View Booking Details\n");
        printf("7. Exit\n");
        printf("=========================================\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        getchar();
        
        switch(choice) {
            case 1:
                displaySeats(seats, totalSeats);
                break;
            case 2:
                bookTicket(seats, totalSeats, bookings, &bookCount);
                break;
            case 3:
                cancelBooking(seats, totalSeats, bookings, &bookCount);
                break;
            case 4:
                viewBookings(bookings, bookCount);
                break;
            case 5:
                availableSeats(seats, totalSeats);
                break;
            case 6:
                viewBookingDetails(bookings, bookCount);
                break;
            case 7:
                printf("\nThank you for using Ticket Booking System!\n");
                break;
            default:
                printf("Invalid choice!\n");
        }
    } while(choice != 7);
    
    return 0;
}

// Initialize seats
void initializeSeats(Seat seats[], int totalSeats) {
    for(int i = 0; i < totalSeats; i++) {
        seats[i].seatNumber = i + 1;
        strcpy(seats[i].passengerName, "");
        seats[i].age = 0;
        seats[i].gender = ' ';
        strcpy(seats[i].bookingStatus, "Available");
    }
}

// Display seats layout
void displaySeats(Seat seats[], int totalSeats) {
    printf("\n--- Seat Layout ---\n");
    printf("========================================================\n");
    printf("  ");
    for(int i = 0; i < 10; i++) {
        printf(" %2d  ", i + 1);
    }
    printf("\n");
    printf("========================================================\n");
    
    for(int row = 0; row < 5; row++) {
        printf("%c ", 'A' + row);
        for(int col = 0; col < 10; col++) {
            int seatIdx = row * 10 + col;
            if(seatIdx < totalSeats) {
                if(strcmp(seats[seatIdx].bookingStatus, "Available") == 0) {
                    printf("[  ] ");
                } else {
                    printf("[XX] ");
                }
            }
        }
        printf("\n");
    }
    printf("========================================================\n");
    printf("Legend: [  ] = Available, [XX] = Booked\n");
}

// Book ticket
void bookTicket(Seat seats[], int totalSeats, Booking bookings[], int *bookCount) {
    if(*bookCount >= 100) {
        printf("Booking database full!\n");
        return;
    }
    
    int seatNo;
    printf("Enter Seat Number (1-50): ");
    scanf("%d", &seatNo);
    getchar();
    
    if(seatNo < 1 || seatNo > totalSeats) {
        printf("Invalid seat number!\n");
        return;
    }
    
    int idx = seatNo - 1;
    if(strcmp(seats[idx].bookingStatus, "Booked") == 0) {
        printf("❌ Seat %d is already booked!\n", seatNo);
        return;
    }
    
    Booking b;
    b.seatNumber = seatNo;
    
    printf("Passenger Name: ");
    fgets(b.passengerName, sizeof(b.passengerName), stdin);
    b.passengerName[strcspn(b.passengerName, "\n")] = '\0';
    
    printf("Age: ");
    scanf("%d", &seats[idx].age);
    getchar();
    
    printf("Gender (M/F): ");
    scanf("%c", &seats[idx].gender);
    getchar();
    
    printf("Booking Date (DD/MM/YYYY): ");
    fgets(b.bookingDate, sizeof(b.bookingDate), stdin);
    b.bookingDate[strcspn(b.bookingDate, "\n")] = '\0';
    
    // Calculate fare
    b.fare = 500.00; // Base fare
    
    // Update seat
    strcpy(seats[idx].passengerName, b.passengerName);
    strcpy(seats[idx].bookingStatus, "Booked");
    
    // Generate booking ID
    b.bookingId = *bookCount + 1001;
    
    bookings[*bookCount] = b;
    (*bookCount)++;
    
    printf("✅ Ticket booked successfully!\n");
    printf("   Booking ID: %d\n", b.bookingId);
    printf("   Seat Number: %d\n", seatNo);
    printf("   Passenger: %s\n", b.passengerName);
    printf("   Fare: ₹%.2f\n", b.fare);
}

// Cancel booking
void cancelBooking(Seat seats[], int totalSeats, Booking bookings[], int *bookCount) {
    if(*bookCount == 0) {
        printf("No bookings found!\n");
        return;
    }
    
    int bookingId;
    printf("Enter Booking ID to cancel: ");
    scanf("%d", &bookingId);
    
    int found = -1;
    for(int i = 0; i < *bookCount; i++) {
        if(bookings[i].bookingId == bookingId) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ Booking ID not found!\n");
        return;
    }
    
    // Free the seat
    int seatIdx = bookings[found].seatNumber - 1;
    strcpy(seats[seatIdx].passengerName, "");
    seats[seatIdx].age = 0;
    seats[seatIdx].gender = ' ';
    strcpy(seats[seatIdx].bookingStatus, "Available");
    
    // Remove booking
    for(int i = found; i < *bookCount - 1; i++) {
        bookings[i] = bookings[i + 1];
    }
    (*bookCount)--;
    
    printf("✅ Booking cancelled successfully!\n");
    printf("   Seat %d is now available.\n", bookings[found].seatNumber);
}

// View all bookings
void viewBookings(Booking bookings[], int bookCount) {
    if(bookCount == 0) {
        printf("No bookings found!\n");
        return;
    }
    
    printf("\n--- All Bookings ---\n");
    printf("================================================================================\n");
    printf("%-10s %-10s %-20s %-15s %-10s\n", 
           "Booking ID", "Seat", "Passenger", "Date", "Fare");
    printf("================================================================================\n");
    
    for(int i = 0; i < bookCount; i++) {
        printf("%-10d %-10d %-20s %-15s ₹%-9.2f\n", 
               bookings[i].bookingId,
               bookings[i].seatNumber,
               bookings[i].passengerName,
               bookings[i].bookingDate,
               bookings[i].fare);
    }
    printf("================================================================================\n");
    printf("Total Bookings: %d\n", bookCount);
}

// View available seats
void availableSeats(Seat seats[], int totalSeats) {
    printf("\n--- Available Seats ---\n");
    int count = 0;
    
    printf("Available seats: ");
    for(int i = 0; i < totalSeats; i++) {
        if(strcmp(seats[i].bookingStatus, "Available") == 0) {
            printf("%d ", i + 1);
            count++;
        }
    }
    
    if(count == 0) {
        printf("No seats available!");
    }
    printf("\nTotal available: %d\n", count);
}

// View booking details
void viewBookingDetails(Booking bookings[], int bookCount) {
    if(bookCount == 0) {
        printf("No bookings found!\n");
        return;
    }
    
    int bookingId;
    printf("Enter Booking ID: ");
    scanf("%d", &bookingId);
    
    for(int i = 0; i < bookCount; i++) {
        if(bookings[i].bookingId == bookingId) {
            printf("\n--- Booking Details ---\n");
            printf("Booking ID: %d\n", bookings[i].bookingId);
            printf("Seat Number: %d\n", bookings[i].seatNumber);
            printf("Passenger Name: %s\n", bookings[i].passengerName);
            printf("Booking Date: %s\n", bookings[i].bookingDate);
            printf("Fare: ₹%.2f\n", bookings[i].fare);
            return;
        }
    }
    printf("❌ Booking ID not found!\n");
}


















