                deleteBook(books, &bookCount);
                break;
            case 10:
                printf("\nExiting system...\n");
                break;
            default:
                printf("Invalid choice!\n");
        }
    } while(choice != 10);
    
    return 0;
}

// Add new book
void addBook(Book books[], int *bookCount) {
    if(*bookCount >= 100) {
        printf("Database full!\n");
        return;
    }
    
    Book b;
    printf("\n--- Add Book ---\n");
    printf("Book ID: ");
    scanf("%d", &b.id);
    getchar();
    
    // Check for duplicate ID
    for(int i = 0; i < *bookCount; i++) {
        if(books[i].id == b.id) {
            printf("Book ID already exists!\n");
            return;
        }
    }
    
    printf("Title: ");
    fgets(b.title, sizeof(b.title), stdin);
    b.title[strcspn(b.title, "\n")] = '\0';
    
    printf("Author: ");
    fgets(b.author, sizeof(b.author), stdin);
    b.author[strcspn(b.author, "\n")] = '\0';
    
    printf("Publisher: ");
    fgets(b.publisher, sizeof(b.publisher), stdin);
    b.publisher[strcspn(b.publisher, "\n")] = '\0';
    
    printf("Publication Year: ");
    scanf("%d", &b.year);
    
    printf("Quantity: ");
    scanf("%d", &b.quantity);
    
    b.available = b.quantity;
    b.issuedCount = 0;
    
    books[*bookCount] = b;
    (*bookCount)++;
    printf("✅ Book added successfully!\n");
}

// Display all books
void displayBooks(Book books[], int bookCount) {
    if(bookCount == 0) {
        printf("No books in library!\n");
        return;
    }
    
    printf("\n--- Library Books ---\n");
    printf("================================================================================\n");
    printf("%-6s %-30s %-20s %-15s %-6s %-10s %-8s\n", 
           "ID", "Title", "Author", "Publisher", "Year", "Available", "Issued");
    printf("================================================================================\n");
    
    for(int i = 0; i < bookCount; i++) {
        printf("%-6d %-30s %-20s %-15s %-6d %-10d %-8d\n", 
               books[i].id,
               books[i].title,
               books[i].author,
               books[i].publisher,
               books[i].year,
               books[i].available,
               books[i].issuedCount);
    }
    printf("================================================================================\n");
    printf("Total Books: %d\n", bookCount);
}

// Search book
void searchBook(Book books[], int bookCount) {
    if(bookCount == 0) {
        printf("No books in library!\n");
        return;
    }
    
    int choice;
    printf("\n--- Search Book ---\n");
    printf("1. Search by ID\n");
    printf("2. Search by Title\n");
    printf("3. Search by Author\n");
    printf("Enter choice: ");
    scanf("%d", &choice);
    getchar();
    
    int id;
    char searchStr[100];
    int found = 0;
    
    if(choice == 1) {
        printf("Enter Book ID: ");
        scanf("%d", &id);
        
        for(int i = 0; i < bookCount; i++) {
            if(books[i].id == id) {
                printf("\n✅ Book Found!\n");
                printf("ID: %d\n", books[i].id);
                printf("Title: %s\n", books[i].title);
                printf("Author: %s\n", books[i].author);
                printf("Publisher: %s\n", books[i].publisher);
                printf("Year: %d\n", books[i].year);
                printf("Available: %d\n", books[i].available);
                printf("Issued: %d\n", books[i].issuedCount);
                found = 1;
                break;
            }
        }
    } else if(choice == 2) {
        printf("Enter Title: ");
        fgets(searchStr, sizeof(searchStr), stdin);
        searchStr[strcspn(searchStr, "\n")] = '\0';
        
        for(int i = 0; i < bookCount; i++) {
            if(strstr(books[i].title, searchStr) != NULL) {
                printf("\n✅ Book Found!\n");
                printf("ID: %d, Title: %s, Author: %s, Available: %d\n", 
                       books[i].id, books[i].title, books[i].author, books[i].available);
                found = 1;
            }
        }
    } else if(choice == 3) {
        printf("Enter Author: ");
        fgets(searchStr, sizeof(searchStr), stdin);
        searchStr[strcspn(searchStr, "\n")] = '\0';
        
        for(int i = 0; i < bookCount; i++) {
            if(strstr(books[i].author, searchStr) != NULL) {
                printf("\n✅ Book Found!\n");
                printf("ID: %d, Title: %s, Author: %s, Available: %d\n", 
                       books[i].id, books[i].title, books[i].author, books[i].available);
                found = 1;
            }
        }
    } else {
        printf("Invalid choice!\n");
        return;
    }
    
    if(!found) {
        printf("❌ Book not found!\n");
    }
}

// Issue book
void issueBook(Book books[], int bookCount, Transaction transactions[], int *transCount) {
    if(bookCount == 0) {
        printf("No books in library!\n");
        return;
    }
    
    int id;
    printf("Enter Book ID to issue: ");
    scanf("%d", &id);
    getchar();
    
    int found = -1;
    for(int i = 0; i < bookCount; i++) {
        if(books[i].id == id) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ Book not found!\n");
        return;
    }
    
    if(books[found].available <= 0) {
        printf("❌ Book is not available! All copies are issued.\n");
        return;
    }
    
    Transaction t;
    t.bookId = id;
    printf("Student Name: ");
    fgets(t.studentName, sizeof(t.studentName), stdin);
    t.studentName[strcspn(t.studentName, "\n")] = '\0';
    
    printf("Issue Date (DD/MM/YYYY): ");
    fgets(t.issueDate, sizeof(t.issueDate), stdin);
    t.issueDate[strcspn(t.issueDate, "\n")] = '\0';
    
    printf("Return Date (DD/MM/YYYY): ");
    fgets(t.returnDate, sizeof(t.returnDate), stdin);
    t.returnDate[strcspn(t.returnDate, "\n")] = '\0';
    
    t.issued = 1;
    
    transactions[*transCount] = t;
    (*transCount)++;
    
    books[found].available--;
    books[found].issuedCount++;
    
    printf("✅ Book issued successfully!\n");
    printf("   Book: %s\n", books[found].title);
    printf("   Student: %s\n", t.studentName);
    printf("   Return Date: %s\n", t.returnDate);
}

// Return book
void returnBook(Book books[], int bookCount, Transaction transactions[], int *transCount) {
    if(*transCount == 0) {
        printf("No transactions found!\n");
        return;
    }
    
    int id;
    printf("Enter Book ID to return: ");
    scanf("%d", &id);
    getchar();
    
    int found = -1;
    for(int i = 0; i < *transCount; i++) {
        if(transactions[i].bookId == id && transactions[i].issued == 1) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ No issued record found for this book!\n");
        return;
    }
    
    // Find book and update
    for(int i = 0; i < bookCount; i++) {
        if(books[i].id == id) {
            books[i].available++;
            break;
        }
    }
    
    transactions[found].issued = 0;
    printf("✅ Book returned successfully!\n");
}

// Display transactions
void displayTransactions(Transaction transactions[], int transCount) {
    if(transCount == 0) {
        printf("No transactions!\n");
        return;
    }
    
    printf("\n--- Transactions ---\n");
    printf("================================================================================\n");
    printf("%-8s %-20s %-15s %-15s %-10s\n", 
           "Book ID", "Student Name", "Issue Date", "Return Date", "Status");
    printf("================================================================================\n");
    
    for(int i = 0; i < transCount; i++) {
        printf("%-8d %-20s %-15s %-15s %-10s\n", 
               transactions[i].bookId,
               transactions[i].studentName,
               transactions[i].issueDate,
               transactions[i].returnDate,
               transactions[i].issued ? "Issued" : "Returned");
    }
    printf("================================================================================\n");
}

// Display available books
void displayAvailableBooks(Book books[], int bookCount) {
    if(bookCount == 0) {
        printf("No books in library!\n");
        return;
    }
    
    printf("\n--- Available Books ---\n");
    printf("================================================================================\n");
    printf("%-6s %-30s %-20s %-10s\n", 
           "ID", "Title", "Author", "Available");
    printf("================================================================================\n");
    
    int availableCount = 0;
    for(int i = 0; i < bookCount; i++) {
        if(books[i].available > 0) {
            printf("%-6d %-30s %-20s %-10d\n", 
                   books[i].id,
                   books[i].title,
                   books[i].author,
                   books[i].available);
            availableCount++;
        }
    }
    
    if(availableCount == 0) {
        printf("No books available at the moment!\n");
    }
    printf("================================================================================\n");
    printf("Available Books: %d\n", availableCount);
}

// Update book
void updateBook(Book books[], int bookCount) {
    if(bookCount == 0) {
        printf("No books in library!\n");
        return;
    }
    
    int id;
    printf("Enter Book ID to update: ");
    scanf("%d", &id);
    getchar();
    
    int found = -1;
    for(int i = 0; i < bookCount; i++) {
        if(books[i].id == id) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ Book not found!\n");
        return;
    }
    
    printf("\n--- Update Book (ID: %d) ---\n", books[found].id);
    printf("Current Title: %s\n", books[found].title);
    printf("New Title (press Enter to keep): ");
    char newTitle[100];
    fgets(newTitle, sizeof(newTitle), stdin);
    if(newTitle[0] != '\n') {
        newTitle[strcspn(newTitle, "\n")] = '\0';
        strcpy(books[found].title, newTitle);
    }
    
    printf("Current Quantity: %d\n", books[found].quantity);
    printf("New Quantity (-1 to keep): ");
    int qty;
    scanf("%d", &qty);
    if(qty >= 0) {
        int diff = qty - books[found].quantity;
        books[found].quantity = qty;
        books[found].available += diff;
    }
    
    printf("✅ Book updated successfully!\n");
}

// Delete book
void deleteBook(Book books[], int *bookCount) {
    if(*bookCount == 0) {
        printf("No books in library!\n");
        return;
    }
    
    int id;
    printf("Enter Book ID to delete: ");
    scanf("%d", &id);
    
    int found = -1;
    for(int i = 0; i < *bookCount; i++) {
        if(books[i].id == id) {
            found = i;
            break;
        }
    }
    
    if(found == -1) {
        printf("❌ Book not found!\n");
        return;
    }
    
    printf("Are you sure you want to delete '%s'? (y/n): ", books[found].title);
    char confirm;
    scanf(" %c", &confirm);
    
    if(confirm == 'y' || confirm == 'Y') {
        for(int i = found; i < *bookCount - 1; i++) {
            books[i] = books[i + 1];
        }
        (*bookCount)--;
        printf("✅ Book deleted successfully!\n");
    } else {
        printf("Deletion cancelled.\n");
    }
}
























