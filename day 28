        printf("5. Return Book\n");
        printf("6. View Transactions\n");
        printf("7. View Available Books\n");
        printf("8. Update Book\n");
        printf("9. Delete Book\n");
        printf("10. Exit\n");
        printf("=========================================\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        getchar();
        
        switch(choice) {
            case 1:
                addBook(books, &bookCount);
                break;
            case 2:
                displayBooks(books, bookCount);
                break;
            case 3:
                searchBook(books, bookCount);
                break;
            case 4:
                issueBook(books, bookCount, transactions, &transCount);
                break;
            case 5:
                returnBook(books, bookCount, transactions, &transCount);
                break;
            case 6:
                displayTransactions(transactions, transCount);
                break;
            case 7:
                displayAvailableBooks(books, bookCount);
                break;
            case 8:
                updateBook(books, bookCount);
                break;
