// Create new account
void createAccount(Account accounts[], int *count) {
    if(*count >= 100) {
        printf("Database full!\n");
        return;
    }
    
    Account acc;
    printf("\n--- Create Account ---\n");
    printf("Account Number: ");
    scanf("%d", &acc.accountNo);
    getchar();
    
    // Check for duplicate account number
    for(int i = 0; i < *count; i++) {
        if(accounts[i].accountNo == acc.accountNo) {
            printf("Account number already exists!\n");
            return;
        }
    }
    
    printf("Account Holder Name: ");
    fgets(acc.name, sizeof(acc.name), stdin);
    acc.name[strcspn(acc.name, "\n")] = '\0';
    
    printf("Account Type (Savings/Current): ");
    fgets(acc.accountType, sizeof(acc.accountType), stdin);
    acc.accountType[strcspn(acc.accountType, "\n")] = '\0';
    
    printf("Initial Deposit: ₹");
    scanf("%f", &acc.balance);
    getchar();
    
    printf("Phone Number: ");
    fgets(acc.phone, sizeof(acc.phone), stdin);
    acc.phone[strcspn(acc.phone, "\n")] = '\0';
    
    printf("Address: ");
    fgets(acc.address, sizeof(acc.address), stdin);
    acc.address[strcspn(acc.address, "\n")] = '\0';
    
    acc.transCount = 0;
    acc.transactions[acc.transCount] = 1; // 1 for deposit
    acc.transactionAmounts[acc.transCount] = acc.balance;
    acc.transCount++;
    
    accounts[*count] = acc;
    (*count)++;
    printf("✅ Account created successfully!\n");
    printf("   Account Number: %d\n", acc.accountNo);
    printf("   Initial Balance: ₹%.2f\n", acc.balance);
}

// Deposit money
void deposit(Account accounts[], int count) {
    int accNo;
    float amount;
    
    printf("Enter Account Number: ");
    scanf("%d", &accNo);
    
    for(int i = 0; i < count; i++) {
        if(accounts[i].accountNo == accNo) {
            printf("Current Balance: ₹%.2f\n", accounts[i].balance);
            printf("Enter amount to deposit: ₹");
            scanf("%f", &amount);
            
            if(amount <= 0) {
                printf("Invalid amount!\n");
                return;
            }
            
            accounts[i].balance += amount;
            
            // Record transaction
            accounts[i].transactions[accounts[i].transCount] = 1; // Deposit
            accounts[i].transactionAmounts[accounts[i].transCount] = amount;
            accounts[i].transCount++;
            
            printf("✅ ₹%.2f deposited successfully!\n", amount);
            printf("   New Balance: ₹%.2f\n", accounts[i].balance);
            return;
        }
    }
    printf("❌ Account not found!\n");
}

// Withdraw money
void withdraw(Account accounts[], int count) {
    int accNo;
    float amount;
    
    printf("Enter Account Number: ");
    scanf("%d", &accNo);
    
    for(int i = 0; i < count; i++) {
        if(accounts[i].accountNo == accNo) {
            printf("Current Balance: ₹%.2f\n", accounts[i].balance);
            printf("Enter amount to withdraw: ₹");
            scanf("%f", &amount);
            
            if(amount <= 0) {
                printf("Invalid amount!\n");
                return;
            }
            
            if(amount > accounts[i].balance) {
                printf("❌ Insufficient balance!\n");
                return;
            }
            
            accounts[i].balance -= amount;
            
            // Record transaction
            accounts[i].transactions[accounts[i].transCount] = 0; // Withdrawal
            accounts[i].transactionAmounts[accounts[i].transCount] = amount;
            accounts[i].transCount++;
            
            printf("✅ ₹%.2f withdrawn successfully!\n", amount);
            printf("   New Balance: ₹%.2f\n", accounts[i].balance);
            return;
        }
    }
    printf("❌ Account not found!\n");
}

