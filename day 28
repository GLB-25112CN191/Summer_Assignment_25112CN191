// Transfer money
void transferMoney(Account accounts[], int count) {
    int fromAcc, toAcc;
    float amount;
    
    printf("Enter your Account Number: ");
    scanf("%d", &fromAcc);
    printf("Enter recipient Account Number: ");
    scanf("%d", &toAcc);
    
    if(fromAcc == toAcc) {
        printf("Cannot transfer to same account!\n");
        return;
    }
    
    int fromIdx = -1, toIdx = -1;
    for(int i = 0; i < count; i++) {
        if(accounts[i].accountNo == fromAcc) fromIdx = i;
        if(accounts[i].accountNo == toAcc) toIdx = i;
    }
    
    if(fromIdx == -1) {
        printf("❌ Your account not found!\n");
        return;
    }
    if(toIdx == -1) {
        printf("❌ Recipient account not found!\n");
        return;
    }
    
    printf("Your Balance: ₹%.2f\n", accounts[fromIdx].balance);
    printf("Enter amount to transfer: ₹");
    scanf("%f", &amount);
    
    if(amount <= 0) {
        printf("Invalid amount!\n");
        return;
    }
    
    if(amount > accounts[fromIdx].balance) {
        printf("❌ Insufficient balance!\n");
        return;
    }
    
    // Process transfer
    accounts[fromIdx].balance -= amount;
    accounts[toIdx].balance += amount;
    
    // Record transactions
    accounts[fromIdx].transactions[accounts[fromIdx].transCount] = 0; // Withdrawal
    accounts[fromIdx].transactionAmounts[accounts[fromIdx].transCount] = amount;
    accounts[fromIdx].transCount++;
    
    accounts[toIdx].transactions[accounts[toIdx].transCount] = 1; // Deposit
    accounts[toIdx].transactionAmounts[accounts[toIdx].transCount] = amount;
    accounts[toIdx].transCount++;
    
    printf("✅ ₹%.2f transferred successfully to Account %d!\n", amount, toAcc);
    printf("   New Balance: ₹%.2f\n", accounts[fromIdx].balance);
}

